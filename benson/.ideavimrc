nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

let mapleader=" "
map <leader>[ <Action>(Back) 
map <leader>mv <Action>(RenameElement)
map <leader>l <Action>(ReformatCode)
map <leader>b <Action>(GotoDeclaration)
map <leader>o <Action>(GotoFile)
map <leader>f <Action>(FindInPath)
map <C-b>m <Action>(ActivateTerminalToolWindow)
