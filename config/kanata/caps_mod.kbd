(defcfg
  process-unmapped-keys no
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
                           spc
)

(deflayer default
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
 @caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
                           spc
)

(deflayer vim
  grv  1                              2                              3                              4                              5                              6                              7                              8                              9                              🔇                             🔉                             🔊                             bspc
  tab  (multi lsft lctl lalt lmet q)  (multi lsft lctl lalt lmet w)  (multi lsft lctl lalt lmet e)  (multi lsft lctl lalt lmet r)  (multi lsft lctl lalt lmet t)  (multi lsft lctl lalt lmet y)  (multi lsft lctl lalt lmet u)  (multi lsft lctl lalt lmet i)  (multi lsft lctl lalt lmet o)  (multi lsft lctl lalt lmet p)  ◀◀                             ▶▶                             (multi lsft lctl lalt lmet \)
 @caps (multi lsft lctl lalt lmet a)  (multi lsft lctl lalt lmet s)  (multi lsft lctl lalt lmet d)  (multi lsft lctl lalt lmet f)  (multi lsft lctl lalt lmet g)  left                           down                           up                             right                          (multi lsft lctl lalt lmet ;)  (multi lsft lctl lalt lmet ')  ret
  caps (multi lsft lctl lalt lmet z)  (multi lsft lctl lalt lmet x)  (multi lsft lctl lalt lmet c)  (multi lsft lctl lalt lmet v)  (multi lsft lctl lalt lmet b)  (multi lsft lctl lalt lmet n)  (multi lsft lctl lalt lmet m)  (multi lsft lctl lalt lmet ,)  (multi lsft lctl lalt lmet .)  (multi lsft lctl lalt lmet /)  rsft
  ▶⏸
)

(defalias
  caps (layer-while-held vim)
)
